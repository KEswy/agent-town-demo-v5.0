# 默认配置完全离线，不需要 API Key。
ENABLE_LLM=false
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=0.35

# 发布包默认使用已通过金丝雀的 local 策略（置信度门禁 + 本地模型评分）。
AGENT_TOWN_NPC_POLICY_MODE=local
AGENT_TOWN_DISABLE_VECTOR_RAG=1
